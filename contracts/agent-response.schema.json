{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mock.local/schemas/agent-response.schema.json",
  "title":"Hotel Refund Agent Response",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","mock","session_id","case_id","trace_id","conversation_state","case_status","message","expectation","allowed_actions","evidence_refs"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "mock":{"const":true},
    "session_id":{"type":"string"},
    "case_id":{"type":"string"},
    "trace_id":{"type":"string"},
    "conversation_state":{"type":"string"},
    "case_status":{"type":"string"},
    "risk_level":{"enum":["L0","L1","L2","L3","L4"]},
    "message":{
      "type":"object",
      "additionalProperties":false,
      "required":["conclusion","status_text","next_step_text"],
      "properties":{
        "conclusion":{"type":"string"},
        "money_text":{"type":["string","null"]},
        "basis_text":{"type":["string","null"]},
        "status_text":{"type":"string"},
        "next_step_text":{"type":"string"}
      }
    },
    "money":{
      "type":["object","null"],
      "additionalProperties":false,
      "required":["currency","paid_amount","refund_amount","cancellation_fee","source_tool_result_id"],
      "properties":{
        "currency":{"type":"string"},
        "paid_amount":{"type":"integer"},
        "refund_amount":{"type":"integer"},
        "cancellation_fee":{"type":"integer"},
        "source_tool_result_id":{"type":"string"}
      }
    },
    "expectation":{
      "type":"object",
      "additionalProperties":false,
      "required":["confirmed_fact","current_state","waiting_for","next_update_at","user_action_required","fallback_after_deadline"],
      "properties":{
        "confirmed_fact":{"type":["string","null"]},
        "current_state":{"type":"string"},
        "waiting_for":{"enum":["USER","HOTEL","SUPPLIER","PAYMENT_CHANNEL","FINANCE","HUMAN_SPECIALIST","NONE"]},
        "next_update_at":{"type":["string","null"],"format":"date-time"},
        "user_action_required":{"type":"boolean"},
        "fallback_after_deadline":{"type":["string","null"]},
        "unknown_reason":{"type":["string","null"]}
      }
    },
    "options":{
      "type":"array",
      "maxItems":3,
      "items":{"type":"object","additionalProperties":false,"required":["option_id","label","consequence"],"properties":{"option_id":{"type":"string"},"label":{"type":"string"},"consequence":{"type":"string"},"expires_at":{"type":["string","null"],"format":"date-time"}}}
    },
    "allowed_actions":{
      "type":"array",
      "items":{"type":"object","additionalProperties":false,"required":["action_id","label","action_type","requires_confirmation"],"properties":{"action_id":{"type":"string"},"label":{"type":"string"},"action_type":{"type":"string"},"requires_confirmation":{"type":"boolean"},"confirmation_summary":{"type":["string","null"]}}}
    },
    "order_summary":{"type":["object","null"]},
    "timeline":{"type":"array","items":{"type":"object","required":["event_type","label","status"],"properties":{"event_type":{"type":"string"},"label":{"type":"string"},"status":{"enum":["DONE","CURRENT","PENDING","UNKNOWN"]},"occurred_at":{"type":["string","null"],"format":"date-time"}}}},
    "handoff":{"type":["object","null"],"required":["handoff_id","queue","response_due_at","context_carried"],"properties":{"handoff_id":{"type":"string"},"queue":{"type":"string"},"response_due_at":{"type":"string","format":"date-time"},"context_carried":{"type":"array","items":{"type":"string"}}}},
    "evidence_refs":{"type":"array","items":{"type":"object","required":["kind","id"],"properties":{"kind":{"enum":["ORDER","POLICY","TOOL_RESULT","CASE_EVENT","EVIDENCE"]},"id":{"type":"string"}}}},
    "demo_trace":{
      "type":["object","null"],
      "description":"Available only in interview demo mode; never expose hidden chain-of-thought.",
      "properties":{"workflow_node":{"type":"string"},"actor":{"type":"string"},"confirmed_facts":{"type":"array","items":{"type":"string"}},"policy_or_rule":{"type":"array","items":{"type":"string"}},"tool_calls":{"type":"array","items":{"type":"object","required":["name","status","result_summary"],"properties":{"name":{"type":"string"},"status":{"type":"string"},"result_summary":{"type":"string"}}}},"state_transition":{"type":"string"}}
    }
  }
}
