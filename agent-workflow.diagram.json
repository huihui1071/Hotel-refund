{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "酒店退款 Agent 全链路 Workflow",
    "locale": "zh-CN",
    "animation": "none",
    "quality_profile": "showcase"
  },
  "lanes": [
    { "id": "user", "label": "用户交互" },
    { "id": "agent", "label": "Agent 理解与编排" },
    { "id": "facts", "label": "规则、业务 Tool 与执行" },
    { "id": "exception", "label": "协商、风险与人工", "variant": "exception" }
  ],
  "phases": [
    { "id": "intake", "label": "理解问题", "fromCol": 0, "toCol": 1 },
    { "id": "grounding", "label": "确认对象与事实", "fromCol": 2, "toCol": 3 },
    { "id": "resolution", "label": "决策与业务闭环", "fromCol": 4, "toCol": 5, "variant": "emphasis" }
  ],
  "groups": [
    { "id": "truth_base", "label": "订单级事实底座", "lane": "facts", "fromCol": 3, "toCol": 5, "variant": "dashed" },
    { "id": "human_boundary", "label": "非自动化边界", "lane": "exception", "fromCol": 4, "toCol": 5, "variant": "security" }
  ],
  "mainPath": [
    "request",
    "safety_intent",
    "order_confirm",
    "fact_hydration",
    "completeness",
    "business_route",
    "auto_resolution"
  ],
  "semanticChecks": {
    "allowedRoots": ["request"],
    "allowedTerminals": ["auto_resolution", "refund_resolution", "supplier_resolution", "urgent_resolution"],
    "requiredPaths": [
      { "from": "request", "to": "auto_resolution" },
      { "from": "business_route", "to": "supplier_resolution" },
      { "from": "business_route", "to": "refund_resolution" },
      { "from": "business_route", "to": "urgent_resolution" }
    ]
  },
  "nodes": [
    {
      "id": "request",
      "lane": "user",
      "col": 0,
      "type": "external",
      "label": "接收用户问题",
      "sublabel": "自由表达、快捷入口或会话恢复",
      "tag": "创建 trace_id",
      "width": 168
    },
    {
      "id": "safety_intent",
      "lane": "agent",
      "col": 1,
      "type": "security",
      "label": "安全预检与意图理解",
      "sublabel": "识别任务、原因、紧急度与越权风险",
      "tag": "LLM 结构化输出",
      "width": 184
    },
    {
      "id": "order_confirm",
      "lane": "user",
      "col": 2,
      "type": "frontend",
      "label": "确认唯一订单",
      "sublabel": "从登录态候选订单中显式选择",
      "tag": "防止查错与误操作",
      "width": 170
    },
    {
      "id": "fact_hydration",
      "lane": "facts",
      "col": 3,
      "type": "database",
      "label": "并行读取业务事实",
      "sublabel": "订单、成交政策、售后、退款与工单",
      "tag": "只读 Tool",
      "width": 184
    },
    {
      "id": "completeness",
      "lane": "agent",
      "col": 3,
      "type": "backend",
      "label": "检查信息完整度",
      "sublabel": "只追问会改变处理结论的字段",
      "tag": "一次最多两个问题",
      "width": 178
    },
    {
      "id": "business_route",
      "lane": "agent",
      "col": 4,
      "type": "backend",
      "label": "业务分流",
      "sublabel": "按政策、状态、风险选择可执行路径",
      "tag": "显式状态机",
      "width": 174
    },
    {
      "id": "auto_resolution",
      "lane": "facts",
      "col": 5,
      "type": "security",
      "label": "自动方案 → 确认 → 执行",
      "sublabel": "规则报价、二次确认、幂等写入、回执校验",
      "tag": "低风险闭环",
      "width": 206
    },
    {
      "id": "refund_resolution",
      "lane": "facts",
      "col": 4,
      "type": "messagebus",
      "label": "查询退款进度",
      "sublabel": "展示渠道状态、预计到账与超时升级条件",
      "tag": "状态可解释",
      "width": 194
    },
    {
      "id": "supplier_resolution",
      "lane": "exception",
      "col": 4,
      "type": "external",
      "label": "供应商协商",
      "sublabel": "建协作单，明确等待方、SLA 与下一次更新",
      "tag": "不承诺结果",
      "width": 194
    },
    {
      "id": "urgent_resolution",
      "lane": "exception",
      "col": 5,
      "type": "security",
      "label": "紧急恢复／人工兜底",
      "sublabel": "到店无房先保住宿；高风险携上下文转人工",
      "tag": "恢复优先",
      "width": 206
    }
  ],
  "edges": [
    { "id": "request-to-intent", "from": "request", "to": "safety_intent", "label": "用户问题", "variant": "default", "role": "main" },
    { "id": "intent-to-order", "from": "safety_intent", "to": "order_confirm", "label": "任务与订单线索", "variant": "emphasis", "role": "main" },
    { "id": "order-to-facts", "from": "order_confirm", "to": "fact_hydration", "label": "confirmed_order_id", "variant": "default", "role": "main" },
    { "id": "facts-to-completeness", "from": "fact_hydration", "to": "completeness", "label": "可信事实", "variant": "default", "role": "main" },
    { "id": "complete-to-route", "from": "completeness", "to": "business_route", "label": "信息完整", "variant": "emphasis", "role": "main" },
    { "id": "route-to-auto", "from": "business_route", "to": "auto_resolution", "label": "政策明确且低风险", "variant": "emphasis", "role": "main" },
    { "id": "route-to-refund", "from": "business_route", "to": "refund_resolution", "label": "退款已发起", "variant": "default", "role": "branch" },
    { "id": "route-to-supplier", "from": "business_route", "to": "supplier_resolution", "label": "需酒店或供应商确认", "variant": "dashed", "role": "branch" },
    { "id": "route-to-urgent", "from": "business_route", "to": "urgent_resolution", "label": "到店无房或高风险", "variant": "security", "role": "error" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "职责分工",
      "items": [
        "LLM 理解与表达；规则决定金额和权限",
        "Tool 读取或写入真实状态；人工处理例外"
      ]
    },
    {
      "dot": "amber",
      "title": "三道关键护栏",
      "items": [
        "订单必须显式确认，写操作必须二次确认和幂等",
        "每次回复先核对金额、状态、时间和政策来源"
      ]
    },
    {
      "dot": "emerald",
      "title": "闭环标准",
      "items": [
        "不是机器人回复完成，而是业务状态真实推进",
        "等待外部时显示责任方、SLA 和下一更新时间"
      ]
    }
  ]
}
